---
import AuthControl from "./AuthControl.astro";
import { withBase } from "../lib/base";

interface Props {
  guideId: string;
  guideTitle: string;
}

const { guideId, guideTitle } = Astro.props;
---

<nav class="viewer-bar" aria-label="Guide viewer controls">
  <div class="viewer-brand">
    <a class="home-link" href={withBase()}>
      <span class="home-chevron" aria-hidden="true">←</span>
      <span>Guides</span>
    </a>
    <span class="viewer-divider" aria-hidden="true"></span>
    <div class="viewer-heading">
      <p class="viewer-title">{guideTitle}</p>
    </div>
  </div>

  <div class="viewer-actions">
    <button
      class="viewer-note"
      type="button"
      data-workbook-note
      data-workbook-id={guideId}
      data-workbook-title={guideTitle}
      data-has-note="false"
      aria-label="Add note"
      title="Add a note for this guide"
    >
      <span class="note-label">Add note</span>
    </button>
    <button class="print-button" type="button">Print</button>
    <AuthControl compact />
  </div>
</nav>

<script>
  import { bindNoteButton, updateNoteButton } from "../lib/note-modal";
  import { startNotesSync, subscribeNotesChanges } from "../lib/notes-sync";
  import { getWorkbookNote } from "../lib/workbook-notes";

  const printButton = document.querySelector(".print-button");
  const noteButton = document.querySelector(".viewer-note[data-workbook-note]");

  const guideId =
    noteButton instanceof HTMLElement ? noteButton.dataset.workbookId : undefined;

  startNotesSync();

  if (noteButton instanceof HTMLElement && guideId) {
    bindNoteButton(noteButton, {
      workbookId: guideId,
      workbookTitle: noteButton.dataset.workbookTitle
    });

    subscribeNotesChanges(() => {
      updateNoteButton(noteButton, getWorkbookNote(guideId));
    });
  }

  printButton?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .viewer-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 10px clamp(14px, 3vw, 28px);
    color: var(--ink);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 92%) 0%, rgb(248 251 253 / 88%) 100%);
    border-bottom: 1px solid rgb(43 131 184 / 16%);
    box-shadow: 0 8px 24px rgb(23 50 77 / 6%);
    backdrop-filter: blur(12px);
    font-family: "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
  }

  .viewer-brand {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: center;
    min-width: 0;
  }

  .home-link {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 6px 10px 6px 8px;
    border-radius: 999px;
    color: var(--muted);
    background: transparent;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .home-chevron {
    font-size: 14px;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .home-link:hover,
  .home-link:focus-visible {
    color: var(--ink);
    background: rgb(43 131 184 / 10%);
    outline: none;
  }

  .home-link:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }

  .home-link:hover .home-chevron,
  .home-link:focus-visible .home-chevron {
    transform: translateX(-2px);
  }

  .viewer-divider {
    width: 1px;
    height: 18px;
    background: rgb(43 131 184 / 22%);
  }

  .viewer-heading {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .viewer-title {
    margin: 0;
    min-width: 0;
    color: var(--ink);
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(16px, 2.4vw, 19px);
    font-weight: 650;
    font-optical-sizing: auto;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .viewer-note {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    width: max-content;
    max-width: min(16rem, 40vw);
    margin: 0;
    padding: 8px 12px;
    overflow: hidden;
    border: 1px solid rgb(23 50 77 / 10%);
    border-radius: 999px;
    color: var(--muted);
    background: rgb(237 242 245 / 90%);
    box-shadow: none;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .viewer-note :global(.note-glyph) {
    flex: 0 0 auto;
    display: block;
  }

  .viewer-note :global(.note-label) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .viewer-note[data-has-note="true"] {
    color: var(--ink);
  }

  .viewer-note[data-has-note="true"] :global(.note-glyph) {
    color: var(--blue-strong);
  }

  .viewer-note:hover,
  .viewer-note:focus-visible {
    outline: none;
    color: var(--ink);
    background: #e4ebf0;
    border-color: rgb(43 131 184 / 28%);
  }

  .viewer-note:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }

  .viewer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .print-button {
    min-width: 7.5rem;
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(145deg, #3a96c9 0%, var(--blue-strong) 100%);
    box-shadow: 0 6px 14px rgb(43 131 184 / 28%);
    font: 700 13px/1 "Source Sans 3", "Trebuchet MS", "Segoe UI", sans-serif;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .print-button:hover,
  .print-button:focus-visible {
    background: linear-gradient(145deg, #48a3d4 0%, #3279a9 100%);
    outline: none;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgb(43 131 184 / 34%);
  }

  .print-button:focus-visible {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }

  @media (max-width: 560px) {
    .viewer-bar {
      gap: 8px;
      align-items: stretch;
      min-height: 0;
      padding: 8px 12px;
    }

    .viewer-brand {
      width: 100%;
      gap: 4px 8px;
    }

    .home-link {
      padding: 8px 10px 8px 8px;
      min-height: 40px;
    }

    .viewer-divider {
      display: none;
    }

    .viewer-title {
      font-size: 15px;
    }

    .viewer-actions {
      width: 100%;
      gap: 6px;
    }

    .viewer-note {
      max-width: 100%;
      flex: 1 1 100%;
      min-height: 40px;
      padding: 8px 12px;
    }

    .print-button {
      flex: 1;
      min-width: 0;
      min-height: 40px;
      padding: 8px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-link,
    .home-chevron,
    .print-button,
    .viewer-note {
      transition: none;
    }

    .home-link:hover .home-chevron,
    .home-link:focus-visible .home-chevron,
    .print-button:hover,
    .print-button:focus-visible {
      transform: none;
    }
  }

  @media print {
    .viewer-bar {
      display: none;
    }
  }
</style>
