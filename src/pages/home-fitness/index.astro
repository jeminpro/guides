---
import GuideLayout from "../../layouts/GuideLayout.astro";
import Sheets from "../../guides/home-fitness/Sheets.astro";
import {
  GUIDE_DESCRIPTION,
  GUIDE_ID,
  GUIDE_TITLE,
  PAGE_COUNT
} from "../../guides/home-fitness/meta";
import "../../guides/home-fitness/styles/guide.css";
---

<GuideLayout
  title={`${GUIDE_TITLE} · Guides`}
  guideId={GUIDE_ID}
  guideTitle={GUIDE_TITLE}
  expectedPages={PAGE_COUNT}
>
  <Fragment slot="head">
    <meta name="description" content={GUIDE_DESCRIPTION} />
  </Fragment>
  <Sheets />
</GuideLayout>
