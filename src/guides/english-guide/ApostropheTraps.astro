---
const traps = [
  {
    title: "Random Apostrophes on Plurals",
    lines: [
      { text: "Apple’s for sale.", mark: "no" },
      { text: "Apples for sale.", mark: "yes" }
    ]
  },
  {
    title: "Mixing Up It’s / Its",
    lines: [
      { text: "The cat licked it’s fur.", mark: "no" },
      { text: "The cat licked its fur.", mark: "yes" }
    ]
  },
  {
    title: "Apostrophes Missing in Possession",
    lines: [
      { text: "The dogs tails were muddy.", mark: "no" },
      { text: "The dogs’ tails were muddy.", mark: "yes" }
    ]
  },
  {
    title: "Wrong Side of the S",
    lines: [
      { text: "The boy’s hats were red.", mark: "no" },
      { text: "(if more than one boy)" },
      { text: "The boys’ hats were red.", mark: "yes" }
    ]
  }
];
---

<div class="topic-sheet">
  <h1>Apostrophes</h1>
  <p class="topic-lead">Common traps</p>
  <div class="trap-card">
    {
      traps.map((trap) => (
        <section class="trap">
          <h2>{trap.title}</h2>
          {trap.lines.map((line) => (
            <p>
              {line.text}
              {line.mark === "no" && (
                <span class="mark mark-no" aria-label="Incorrect">
                  ✕
                </span>
              )}
              {line.mark === "yes" && (
                <span class="mark mark-yes" aria-label="Correct">
                  ✓
                </span>
              )}
            </p>
          ))}
        </section>
      ))
    }
  </div>
</div>
