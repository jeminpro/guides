---
const rules = [
  {
    tone: "rule-sentence",
    title: "To Show Omitted Words",
    body: "Used when some words are left out – often in quotations or summaries.",
    examplesLabel: "Examples:",
    examples: [
      "The teacher said, “If at first you don’t succeed … try again.”",
      "The message was brief: “We came … we saw … we left.”"
    ]
  },
  {
    tone: "rule-pronoun",
    title: "To Create Suspense or a Pause",
    body: "Ellipsis slows down the reader, hinting at mystery, hesitation, or something left unsaid.",
    examplesLabel: "Examples:",
    examples: ["“I can hear something … behind the door.”", "He looked up … and froze."]
  },
  {
    tone: "rule-proper",
    title: "To Trail Off in Thought",
    examplesLabel: "Examples:",
    examples: ["“Maybe we should … never mind.”", "I was going to tell her but …"]
  }
];
---

<div class="topic-sheet">
  <h1>Ellipsis (...) - When to use</h1>
  <ol class="rule-list">
    {
      rules.map((rule, index) => (
        <li class:list={["rule", rule.tone]}>
          <span class="rule-num" aria-hidden="true">
            {index + 1}
          </span>
          <h2>{rule.title}</h2>
          {rule.body && <p>{rule.body}</p>}
          <p class="rule-label">{rule.examplesLabel}</p>
          <ul>
            {rule.examples.map((example) => (
              <li>{example}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</div>
