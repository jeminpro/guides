---
import GuidePageShell from "../GuidePageShell.astro";
import SectionDivider from "../SectionDivider.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[17];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <SectionDivider title={page.title} />
</GuidePageShell>
