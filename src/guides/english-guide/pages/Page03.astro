---
import GuidePageShell from "../GuidePageShell.astro";
import PunctuationOverview from "../PunctuationOverview.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[2];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <PunctuationOverview />
</GuidePageShell>
