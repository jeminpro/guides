---
import GuidePageShell from "../GuidePageShell.astro";
import NounPhrases from "../NounPhrases.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[47];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <NounPhrases />
</GuidePageShell>
