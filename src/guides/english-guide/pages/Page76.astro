---
import GuidePageShell from "../GuidePageShell.astro";
import IrregularList from "../IrregularList.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[75];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <IrregularList />
</GuidePageShell>
