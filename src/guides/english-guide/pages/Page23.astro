---
import GuidePageShell from "../GuidePageShell.astro";
import Nouns from "../Nouns.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[22];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Nouns />
</GuidePageShell>
