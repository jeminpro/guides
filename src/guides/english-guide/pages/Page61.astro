---
import GuidePageShell from "../GuidePageShell.astro";
import AdverbPlace from "../AdverbPlace.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[60];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <AdverbPlace />
</GuidePageShell>
