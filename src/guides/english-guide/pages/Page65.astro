---
import GuidePageShell from "../GuidePageShell.astro";
import NounPronounCases from "../NounPronounCases.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[64];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <NounPronounCases />
</GuidePageShell>
