---
import GuidePageShell from "../GuidePageShell.astro";
import SentencesPhrases from "../SentencesPhrases.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[39];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <SentencesPhrases />
</GuidePageShell>
