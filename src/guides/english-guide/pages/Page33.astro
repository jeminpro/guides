---
import GuidePageShell from "../GuidePageShell.astro";
import Interjections from "../Interjections.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[32];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Interjections />
</GuidePageShell>
