---
import GuidePageShell from "../GuidePageShell.astro";
import Verbs from "../Verbs.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[20];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Verbs />
</GuidePageShell>
