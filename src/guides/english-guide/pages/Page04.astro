---
import GuidePageShell from "../GuidePageShell.astro";
import VocabContext from "../VocabContext.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[3];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabContext />
</GuidePageShell>
