---
import GuidePageShell from "../GuidePageShell.astro";
import VocabOverview from "../VocabOverview.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[80];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabOverview />
</GuidePageShell>
