---
import GuidePageShell from "../GuidePageShell.astro";
import CapitalTraps from "../CapitalTraps.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[4];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <CapitalTraps />
</GuidePageShell>
