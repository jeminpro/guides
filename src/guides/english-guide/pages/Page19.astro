---
import GuidePageShell from "../GuidePageShell.astro";
import GrammarSummary from "../GrammarSummary.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[18];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <GrammarSummary start={0} end={3} />
</GuidePageShell>
