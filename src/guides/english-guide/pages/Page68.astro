---
import GuidePageShell from "../GuidePageShell.astro";
import AdverbJob from "../AdverbJob.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[67];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <AdverbJob />
</GuidePageShell>
