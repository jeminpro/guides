---
import GuidePageShell from "../GuidePageShell.astro";
import VocabMeanings from "../VocabMeanings.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[87];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabMeanings />
</GuidePageShell>
