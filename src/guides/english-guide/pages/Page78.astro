---
import GuidePageShell from "../GuidePageShell.astro";
import IrregularIntro from "../IrregularIntro.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[77];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <IrregularIntro />
</GuidePageShell>
