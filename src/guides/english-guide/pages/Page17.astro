---
import GuidePageShell from "../GuidePageShell.astro";
import Dashes from "../Dashes.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[16];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Dashes />
</GuidePageShell>
