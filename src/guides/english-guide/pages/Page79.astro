---
import GuidePageShell from "../GuidePageShell.astro";
import IrregularTraps from "../IrregularTraps.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[78];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <IrregularTraps />
</GuidePageShell>
