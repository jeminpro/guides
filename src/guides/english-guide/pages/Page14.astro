---
import GuidePageShell from "../GuidePageShell.astro";
import Ellipsis from "../Ellipsis.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[13];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Ellipsis />
</GuidePageShell>
