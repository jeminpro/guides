---
import GuidePageShell from "../GuidePageShell.astro";
import ApostropheTraps from "../ApostropheTraps.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[15];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <ApostropheTraps />
</GuidePageShell>
