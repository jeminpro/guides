---
import GuidePageShell from "../GuidePageShell.astro";
import Pronouns from "../Pronouns.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[23];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Pronouns />
</GuidePageShell>
