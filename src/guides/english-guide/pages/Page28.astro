---
import GuidePageShell from "../GuidePageShell.astro";
import Adjectives from "../Adjectives.astro";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[27];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Adjectives />
</GuidePageShell>
