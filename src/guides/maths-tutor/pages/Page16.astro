---
import GuidePageShell from "../GuidePageShell.astro";
import bodyHtml from "./page-16-body.html?raw";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[15];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Fragment set:html={bodyHtml} />
</GuidePageShell>
