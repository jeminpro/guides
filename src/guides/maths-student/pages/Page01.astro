---
import GuidePageShell from "../GuidePageShell.astro";
import { PAGE_COUNT, pages } from "../meta";
import bodyHtml from "./page-01-body.html?raw";

const page = pages[0];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <Fragment set:html={bodyHtml} />
</GuidePageShell>
