---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set30 } from "../data/set-30";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[29];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set30} />
</GuidePageShell>
