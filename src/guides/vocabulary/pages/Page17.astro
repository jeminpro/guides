---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set17 } from "../data/set-17";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[16];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set17} />
</GuidePageShell>
