---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set18 } from "../data/set-18";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[17];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set18} />
</GuidePageShell>
