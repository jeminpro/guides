---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set29 } from "../data/set-29";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[28];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set29} />
</GuidePageShell>
