---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set11 } from "../data/set-11";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[10];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set11} />
</GuidePageShell>
