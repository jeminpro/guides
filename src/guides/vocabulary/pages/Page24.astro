---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set24 } from "../data/set-24";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[23];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set24} />
</GuidePageShell>
