---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set20 } from "../data/set-20";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[19];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set20} />
</GuidePageShell>
