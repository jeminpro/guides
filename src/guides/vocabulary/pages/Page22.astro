---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set22 } from "../data/set-22";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[21];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set22} />
</GuidePageShell>
