---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set19 } from "../data/set-19";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[18];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set19} />
</GuidePageShell>
