---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set15 } from "../data/set-15";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[14];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set15} />
</GuidePageShell>
