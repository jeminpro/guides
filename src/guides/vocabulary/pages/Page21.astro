---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set21 } from "../data/set-21";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[20];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set21} />
</GuidePageShell>
