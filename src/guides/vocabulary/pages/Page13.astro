---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set13 } from "../data/set-13";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[12];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set13} />
</GuidePageShell>
