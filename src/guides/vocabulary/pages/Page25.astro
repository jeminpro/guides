---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set25 } from "../data/set-25";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[24];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set25} />
</GuidePageShell>
