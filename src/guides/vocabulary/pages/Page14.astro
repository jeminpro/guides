---
import GuidePageShell from "../GuidePageShell.astro";
import VocabSheet from "../VocabSheet.astro";
import { set14 } from "../data/set-14";
import { PAGE_COUNT, pages } from "../meta";

const page = pages[13];
---

<GuidePageShell
  page={page.number}
  total={PAGE_COUNT}
  label={page.label}
  bodyClass={page.bodyClass}
>
  <VocabSheet set={set14} />
</GuidePageShell>
